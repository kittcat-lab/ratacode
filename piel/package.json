{
  "name": "ratacode-piel",
  "version": "0.1.0",
  "description": "RATACODE · la piel: inyecta el CSS y los guiones de RATACODE en el index que sirve DSH web (index transform tap) y añade las secciones «Modelos locales» y «Conexiones» a Ajustes por la vía oficial de slots.",
  "license": "MIT",
  "author": {
    "name": "Patxi"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/cliente.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "activos",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./modos/arquitecto/preset.patch.yml",
        "./modos/capataz/preset.patch.yml",
        "./modos/faro/preset.patch.yml",
        "./modos/gepeto/preset.patch.yml",
        "./modos/hero/preset.patch.yml",
        "./modos/modo-rata/preset.patch.yml",
        "./modos/nex/preset.patch.yml",
        "./modos/pix/preset.patch.yml",
        "./modos/tirita/preset.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
